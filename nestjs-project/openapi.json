          "uploading",
          "processing",
          "ready",
          "failed"
        ]
      },
      "PublicationStatus": {
        "type": "string",
        "enum": [
          "draft",
          "published"
        ]
      },
      "UploadSessionDto": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string",
            "description": "S3 multipart upload id"
          },
          "partSize": {
            "type": "integer",
            "description": "Bytes per part (the last part may be smaller)"
          },
          "partCount": {
            "type": "integer",
            "description": "ceil(size / partSize)"
          }
        },
        "required": [
          "uploadId",
          "partSize",
          "partCount"
        ]
      },
      "UploadSessionResponseDto": {
        "type": "object",
        "properties": {
          "publicId": {
            "type": "string",
            "example": "aB3_xYz-k9Q",
            "description": "11-character URL id"
          },
          "title": {
            "type": "string"
          },
          "processingStatus": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProcessingStatus"
              }
            ]
          },
          "publicationStatus": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PublicationStatus"
              }
            ]
          },
          "upload": {
            "$ref": "#/components/schemas/UploadSessionDto"
          }
        },
        "required": [
          "publicId",
          "title",
          "processingStatus",
          "publicationStatus",
          "upload"
        ]
      },
      "PresignPartsDto": {
        "type": "object",
        "properties": {}
      },
      "PresignedPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "integer"
          },
          "url": {
            "type": "string",
            "description": "Presigned PUT URL for this part"
          }
        },
        "required": [
          "partNumber",
          "url"
        ]
      },
      "PresignedPartsResponseDto": {
        "type": "object",
        "properties": {
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PresignedPartDto"
            }
          }
        },
        "required": [
          "parts"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "partNumber": {
            "type": "integer"
          },
          "size": {
            "type": "integer",
            "description": "Part size in bytes"
          },
          "etag": {
            "type": "string",
            "description": "ETag returned by the storage for this part"
          }
        },
        "required": [
          "partNumber",
          "size",
          "etag"
        ]
      },
      "UploadedPartsResponseDto": {
        "type": "object",
        "properties": {
          "processingStatus": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProcessingStatus"
              }
            ]
          },
          "partSize": {
            "type": "integer"
          },
          "partCount": {
            "type": "integer"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "processingStatus",
          "partSize",
          "partCount",
          "parts"
        ]
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {}
      },
      "UploadAcceptedResponseDto": {
        "type": "object",
        "properties": {
          "publicId": {
            "type": "string",
            "example": "aB3_xYz-k9Q"
          },
          "processingStatus": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProcessingStatus"
              }
            ]
          }
        },
        "required": [
          "publicId",
          "processingStatus"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "publicId": {
            "type": "string",
            "example": "aB3_xYz-k9Q",
            "description": "11-character URL id"
          },
          "title": {
            "type": "string"
          },
          "processingStatus": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProcessingStatus"
              }
            ]
          },
          "publicationStatus": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PublicationStatus"
              }
            ]
          },
          "failureReason": {
            "type": "string",
            "nullable": true
          },
          "sizeBytes": {
            "type": "integer",
            "description": "Original file size in bytes"
          },
          "durationSeconds": {
            "type": "number",
            "nullable": true
          },
          "width": {
            "type": "integer",
            "nullable": true
          },
          "height": {
            "type": "integer",
            "nullable": true
          },
          "videoCodec": {
            "type": "string",
            "nullable": true
          },
          "formatName": {
            "type": "string",
            "nullable": true
          },
          "hasThumbnail": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "publicId",
          "title",
          "processingStatus",
          "publicationStatus",
          "failureReason",
          "sizeBytes",
          "durationSeconds",
          "width",
          "height",
          "videoCodec",
          "formatName",
          "hasThumbnail",
          "createdAt"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}